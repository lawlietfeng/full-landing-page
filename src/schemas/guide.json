    },
    {
      "id": "guide-install-title",
      "component": "typography",
      "type": "title",
      "content": "环境准备",
      "style": { "fontSize": "28px", "fontWeight": 600, "lineHeight": 1.14, "color": "#1d1d1f", "margin": 0 }
    },
    {
      "id": "guide-install-desc",
      "component": "typography",
      "type": "text",
      "content": "React 18+ 项目即可，安装核心依赖：",
      "style": { "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.47, "color": "#86868b", "margin": 0 }
    },
    {
      "id": "guide-install-code1",
      "component": "box",
      "style": { "backgroundColor": "#1d1d1f", "borderRadius": "12px", "padding": "16px 20px" },
      "children": ["guide-install-code1-text"]
    },
    {
      "id": "guide-install-code1-text",
      "component": "typography",
      "type": "text",
      "content": "npm install faui antd dayjs",
      "style": { "fontSize": "15px", "fontWeight": 400, "color": "#e0e0e0", "margin": 0, "fontFamily": "ui-monospace, 'SF Mono', Monaco, 'Cascadia Code', monospace" }
    },
    {
      "id": "guide-install-code2-label",
      "component": "typography",
      "type": "text",
      "content": "可选：安装 framer-motion 启用动画增强",
      "style": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43, "color": "#86868b", "margin": 0 }
    },
    {
      "id": "guide-install-code2",
      "component": "box",
      "style": { "backgroundColor": "#1d1d1f", "borderRadius": "12px", "padding": "16px 20px" },
      "children": ["guide-install-code2-text"]
    },
    {
      "id": "guide-install-code2-text",
      "component": "typography",
      "type": "text",
      "content": "npm install framer-motion",
      "style": { "fontSize": "15px", "fontWeight": 400, "color": "#e0e0e0", "margin": 0, "fontFamily": "ui-monospace, 'SF Mono', Monaco, 'Cascadia Code', monospace" }
    },
    {
      "id": "guide-install-alert",
      "component": "alert",
      "status": "info",
      "title": "antd 和 dayjs 是 peer dependency，需要和 faui 一起安装。",
      "showIcon": true,
      "style": { "borderRadius": "12px" }
    },
    {
      "id": "guide-install-import-label",
      "component": "typography",
      "type": "text",
      "content": "在入口文件中引入：",
      "style": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.43, "color": "#86868b", "margin": 0 }
    },
    {
      "id": "guide-install-import",
      "component": "box",
      "style": { "backgroundColor": "#1d1d1f", "borderRadius": "12px", "padding": "16px 20px" },

    },
    {
      "id": "guide-install-import-text",
      "component": "typography",
      "type": "text",
      "content": "import { SchemaRenderer, ComponentRegistry } from 'faui/full'",
      "style": { "fontSize": "15px", "fontWeight": 400, "color": "#e0e0e0", "margin": 0, "fontFamily": "ui-monospace, 'SF Mono', Monaco, 'Cascadia Code', monospace" }
    },

    { "id": "__comment_minimal", "component": "box", "visible": false },

    {
      "id": "guide-minimal",
      "component": "box",
      "domId": "guide-minimal-section",
      "align": "center",
      "style": { "backgroundColor": "#272729", "padding": "80px 24px" },
      "children": ["guide-minimal-title", "guide-minimal-desc", "guide-minimal-row", "guide-minimal-alert"],
      "animation": "fade"
    },
    {
      "id": "guide-minimal-title",
      "component": "typography",
      "type": "title",
      "content": "最小示例",
      "style": { "fontSize": "40px", "fontWeight": 600, "lineHeight": 1.1, "color": "#ffffff", "margin": 0, "marginBottom": "12px", "textAlign": "center" }
    },
    {
      "id": "guide-minimal-desc",
      "component": "typography",
      "type": "text",
      "content": "一个完整可运行的 Hello World — 左边是 React 代码，右边是 JSON Schema",
      "style": { "fontSize": "17px", "fontWeight": 400, "lineHeight": 1.47, "color": "#86868b", "margin": 0, "marginBottom": "32px", "textAlign": "center" }
    },
    {
      "id": "guide-minimal-row",
      "component": "row",
      "gutter": [24, 24],
      "align": "top",
      "style": { "maxWidth": "800px", "width": "100%" },
      "children": ["guide-minimal-col-jsx", "guide-minimal-col-json"]
    },
    {
      "id": "guide-minimal-col-jsx",
      "component": "col",
      "xs": 24,
      "lg": 12,
      "children": ["guide-minimal-jsx-card"]
    },
    {
      "id": "guide-minimal-jsx-card",
      "component": "box",
      "style": { "backgroundColor": "#1d1d1f", "borderRadius": "12px", "padding": "24px" },
      "children": ["guide-minimal-jsx-label", "guide-minimal-jsx-code"]
    },
    {
      "id": "guide-minimal-jsx-label",
      "component": "typography",
      "type": "text",
      "content": "App.tsx",
      "style": { "fontSize": "12px", "fontWeight": 400, "color": "#86868b", "margin": 0, "marginBottom": "16px" }
    },
    {
      "id": "guide-minimal-jsx-code",
      "component": "typography",
      "type": "text",
      "content": "import schema from './schema.json'\nimport {\n  SchemaRenderer,\n  ComponentRegistry\n} from 'faui/full'\n\nexport default function App() {\n  return (\n    <SchemaRenderer\n      schema={schema}\n      componentRegistry={\n        ComponentRegistry\n      }\n    />\n  )\n}",
      "style": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.6, "color": "#e0e0e0", "margin": 0, "fontFamily": "ui-monospace, 'SF Mono', Monaco, 'Cascadia Code', monospace", "whiteSpace": "pre" }
    },
    {
      "id": "guide-minimal-col-json",
      "component": "col",
      "xs": 24,
      "lg": 12,
      "children": ["guide-minimal-json-card"]
    },
    {
      "id": "guide-minimal-json-card",
      "component": "box",
      "style": { "backgroundColor": "#1d1d1f", "borderRadius": "12px", "padding": "24px" },
      "children": ["guide-minimal-json-label", "guide-minimal-json-code"]
    },
    {
      "id": "guide-minimal-json-label",
      "component": "typography",
      "type": "text",
      "content": "schema.json",
      "style": { "fontSize": "12px", "fontWeight": 400, "color": "#86868b", "margin": 0, "marginBottom": "16px" }
    },
    {
      "id": "guide-minimal-json-code",
      "component": "typography",
      "type": "text",
      "content": "{\n  \"components\": [\n    {\n      \"id\": \"root\",\n      \"component\": \"box\",\n      \"children\": [\"hello\"]\n    },\n    {\n      \"id\": \"hello\",\n      \"component\": \"typography\",\n      \"type\": \"title\",\n      \"content\": \"Hello FAUI\"\n    }\n  ],\n  \"dataModel\": {},\n  \"root\": [\"root\"]\n}",
      "style": { "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.6, "color": "#e0e0e0", "margin": 0, "fontFamily": "ui-monospace, 'SF Mono', Monaco, 'Cascadia Code', monospace", "whiteSpace": "pre" }
    },
    {
      "id": "guide-minimal-alert",
      "component": "alert",
      "status": "info",
      "title": "schema 必须包含 root 数组来指定入口组件，SchemaRenderer 会从这里开始渲染。",
      "showIcon": true,
      "style": { "borderRadius": "12px", "marginTop": "24px", "maxWidth": "800px", "width": "100%" }
    },

    { "id": "__comment_concepts", "component": "box", "visible": false },


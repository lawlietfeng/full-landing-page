    {
      "id": "hero-title",
      "component": "typography",
      "type": "title",
      "content": "FAUI",
      "className": "hero-gradient-text",
      "style": { "fontSize": "56px", "fontWeight": 600, "lineHeight": 1.07, "letterSpacing": "-0.28px", "color": "#ffffff", "margin": 0, "textAlign": "center", "position": "relative", "zIndex": 1 },
      "animation": { "preset": "fade", "duration": 0.6 }
    },
    {
      "id": "hero-subtitle",
      "component": "typography",
      "type": "title",
      "content": "JSON 驱动的前端渲染引擎",
